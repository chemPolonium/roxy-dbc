<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>FlexRayDb</SHORT-NAME>
      <ELEMENTS>
        <FLEXRAY-CLUSTER>
          <SHORT-NAME>PowertrainCluster</SHORT-NAME>
          <DESC>
            <L-2 L="EN">roxy-fibex FlexRay sample (AUTOSAR R4.0 style)</L-2>
          </DESC>
          <FLEXRAY-COLDSTART-ATTEMPTS>8</FLEXRAY-COLDSTART-ATTEMPTS>
          <FLEXRAY-CYCLE>1000</FLEXRAY-CYCLE>
          <FLEXRAY-G-NUMBER-OF-MINISLOTS>292</FLEXRAY-G-NUMBER-OF-MINISLOTS>
          <FLEXRAY-G-NUMBER-OF-STATIC-SLOTS>10</FLEXRAY-G-NUMBER-OF-STATIC-SLOTS>
          <FLEXRAY-GD-ACTION-POINT-OFFSET>3</FLEXRAY-GD-ACTION-POINT-OFFSET>
          <FLEXRAY-GD-DYNAMIC-SLOT-IDLE-PHASE>1</FLEXRAY-GD-DYNAMIC-SLOT-IDLE-PHASE>
          <FLEXRAY-GD-MACROTICK-DURATION>5.0</FLEXRAY-GD-MACROTICK-DURATION>
          <FLEXRAY-GD-MINISLOT>9</FLEXRAY-GD-MINISLOT>
          <FLEXRAY-GD-MINISLOT-ACTION-POINT-OFFSET>2</FLEXRAY-GD-MINISLOT-ACTION-POINT-OFFSET>
          <FLEXRAY-GD-MINOR-VERSION>3</FLEXRAY-GD-MINOR-VERSION>
          <FLEXRAY-GD-NIT>75</FLEXRAY-GD-NIT>
          <FLEXRAY-GD-STATIC-SLOT>67</FLEXRAY-GD-STATIC-SLOT>
          <FLEXRAY-GD-SYMBOL-WINDOW>1</FLEXRAY-GD-SYMBOL-WINDOW>
          <FLEXRAY-GD-SYMBOL-WINDOW-IDLE-PHASE>1</FLEXRAY-GD-SYMBOL-WINDOW-IDLE-PHASE>
          <FLEXRAY-OFFSET-CORRECTION-START>233</FLEXRAY-OFFSET-CORRECTION-START>
          <FLEXRAY-PHYSICAL-CHANNELS>
            <FLEXRAY-PHYSICAL-CHANNEL>
              <SHORT-NAME>ChannelA</SHORT-NAME>
              <FRAME-TRIGGERINGS>
                <FLEXRAY-FRAME-TRIGGERING>
                  <SHORT-NAME>EngineData_A_Trigger</SHORT-NAME>
                  <FRAME-REF DEST="FLEXRAY-FRAME">/FlexRayDb/EngineData</FRAME-REF>
                  <SLOT-ID>1</SLOT-ID>
                  <CYCLE-REPETITION>CYCLE-REPETITION-1</CYCLE-REPETITION>
                  <BASE-CYCLE>0</BASE-CYCLE>
                  <STARTUP-FRAME>true</STARTUP-FRAME>
                </FLEXRAY-FRAME-TRIGGERING>
                <FLEXRAY-FRAME-TRIGGERING>
                  <SHORT-NAME>TransmissionData_A_Trigger</SHORT-NAME>
                  <FRAME-REF DEST="FLEXRAY-FRAME">/FlexRayDb/TransmissionData</FRAME-REF>
                  <SLOT-ID>2</SLOT-ID>
                  <CYCLE-REPETITION>CYCLE-REPETITION-1</CYCLE-REPETITION>
                  <BASE-CYCLE>0</BASE-CYCLE>
                  <STARTUP-FRAME>true</STARTUP-FRAME>
                </FLEXRAY-FRAME-TRIGGERING>
                <FLEXRAY-FRAME-TRIGGERING>
                  <SHORT-NAME>DashInfo_A_Trigger</SHORT-NAME>
                  <FRAME-REF DEST="FLEXRAY-FRAME">/FlexRayDb/DashInfo</FRAME-REF>
                  <SLOT-ID>4</SLOT-ID>
                  <CYCLE-REPETITION>CYCLE-REPETITION-8</CYCLE-REPETITION>
                  <BASE-CYCLE>0</BASE-CYCLE>
                  <STARTUP-FRAME>false</STARTUP-FRAME>
                </FLEXRAY-FRAME-TRIGGERING>
              </FRAME-TRIGGERINGS>
            </FLEXRAY-PHYSICAL-CHANNEL>
            <FLEXRAY-PHYSICAL-CHANNEL>
              <SHORT-NAME>ChannelB</SHORT-NAME>
              <FRAME-TRIGGERINGS>
                <FLEXRAY-FRAME-TRIGGERING>
                  <SHORT-NAME>EngineData_B_Trigger</SHORT-NAME>
                  <FRAME-REF DEST="FLEXRAY-FRAME">/FlexRayDb/EngineData</FRAME-REF>
                  <SLOT-ID>1</SLOT-ID>
                  <CYCLE-REPETITION>CYCLE-REPETITION-1</CYCLE-REPETITION>
                  <BASE-CYCLE>0</BASE-CYCLE>
                  <STARTUP-FRAME>true</STARTUP-FRAME>
                </FLEXRAY-FRAME-TRIGGERING>
                <FLEXRAY-FRAME-TRIGGERING>
                  <SHORT-NAME>ChassisStatus_B_Trigger</SHORT-NAME>
                  <FRAME-REF DEST="FLEXRAY-FRAME">/FlexRayDb/ChassisStatus</FRAME-REF>
                  <SLOT-ID>3</SLOT-ID>
                  <CYCLE-REPETITION>CYCLE-REPETITION-4</CYCLE-REPETITION>
                  <BASE-CYCLE>0</BASE-CYCLE>
                  <STARTUP-FRAME>false</STARTUP-FRAME>
                </FLEXRAY-FRAME-TRIGGERING>
                <FLEXRAY-FRAME-TRIGGERING>
                  <SHORT-NAME>DashInfo_B_Trigger</SHORT-NAME>
                  <FRAME-REF DEST="FLEXRAY-FRAME">/FlexRayDb/DashInfo</FRAME-REF>
                  <SLOT-ID>4</SLOT-ID>
                  <CYCLE-REPETITION>CYCLE-REPETITION-8</CYCLE-REPETITION>
                  <BASE-CYCLE>0</BASE-CYCLE>
                  <STARTUP-FRAME>false</STARTUP-FRAME>
                </FLEXRAY-FRAME-TRIGGERING>
              </FRAME-TRIGGERINGS>
            </FLEXRAY-PHYSICAL-CHANNEL>
          </FLEXRAY-PHYSICAL-CHANNELS>
        </FLEXRAY-CLUSTER>
        <ECU-INSTANCE>
          <SHORT-NAME>EngECU</SHORT-NAME>
        </ECU-INSTANCE>
        <ECU-INSTANCE>
          <SHORT-NAME>TransECU</SHORT-NAME>
        </ECU-INSTANCE>
        <ECU-INSTANCE>
          <SHORT-NAME>ChassisECU</SHORT-NAME>
        </ECU-INSTANCE>
        <ECU-INSTANCE>
          <SHORT-NAME>DashECU</SHORT-NAME>
        </ECU-INSTANCE>
        <I-SIGNAL-I-PDU>
          <SHORT-NAME>Eng_PDU</SHORT-NAME>
          <LENGTH>4</LENGTH>
          <I-SIGNAL-TO-PDU-MAPPINGS>
            <I-SIGNAL-TO-PDU-MAPPING>
              <SHORT-NAME>EngineSpeed_Map</SHORT-NAME>
              <START-POSITION>0</START-POSITION>
              <LENGTH>16</LENGTH>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-FIRST</PACKING-BYTE-ORDER>
              <I-SIGNAL-REF DEST="I-SIGNAL">/FlexRayDb/EngineSpeed</I-SIGNAL-REF>
            </I-SIGNAL-TO-PDU-MAPPING>
            <I-SIGNAL-TO-PDU-MAPPING>
              <SHORT-NAME>CoolantTemp_Map</SHORT-NAME>
              <START-POSITION>16</START-POSITION>
              <LENGTH>8</LENGTH>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-FIRST</PACKING-BYTE-ORDER>
              <I-SIGNAL-REF DEST="I-SIGNAL">/FlexRayDb/CoolantTemp</I-SIGNAL-REF>
            </I-SIGNAL-TO-PDU-MAPPING>
            <I-SIGNAL-TO-PDU-MAPPING>
              <SHORT-NAME>ThrottlePos_Map</SHORT-NAME>
              <START-POSITION>24</START-POSITION>
              <LENGTH>8</LENGTH>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-FIRST</PACKING-BYTE-ORDER>
              <I-SIGNAL-REF DEST="I-SIGNAL">/FlexRayDb/ThrottlePos</I-SIGNAL-REF>
            </I-SIGNAL-TO-PDU-MAPPING>
          </I-SIGNAL-TO-PDU-MAPPINGS>
        </I-SIGNAL-I-PDU>
        <I-SIGNAL-I-PDU>
          <SHORT-NAME>Trans_PDU</SHORT-NAME>
          <LENGTH>4</LENGTH>
          <I-SIGNAL-TO-PDU-MAPPINGS>
            <I-SIGNAL-TO-PDU-MAPPING>
              <SHORT-NAME>GearEngaged_Map</SHORT-NAME>
              <START-POSITION>0</START-POSITION>
              <LENGTH>8</LENGTH>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-FIRST</PACKING-BYTE-ORDER>
              <I-SIGNAL-REF DEST="I-SIGNAL">/FlexRayDb/GearEngaged</I-SIGNAL-REF>
            </I-SIGNAL-TO-PDU-MAPPING>
            <I-SIGNAL-TO-PDU-MAPPING>
              <SHORT-NAME>TransTemp_Map</SHORT-NAME>
              <START-POSITION>8</START-POSITION>
              <LENGTH>8</LENGTH>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-FIRST</PACKING-BYTE-ORDER>
              <I-SIGNAL-REF DEST="I-SIGNAL">/FlexRayDb/TransTemp</I-SIGNAL-REF>
            </I-SIGNAL-TO-PDU-MAPPING>
            <I-SIGNAL-TO-PDU-MAPPING>
              <SHORT-NAME>TorqueReq_Map</SHORT-NAME>
              <START-POSITION>16</START-POSITION>
              <LENGTH>16</LENGTH>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-FIRST</PACKING-BYTE-ORDER>
              <I-SIGNAL-REF DEST="I-SIGNAL">/FlexRayDb/TorqueReq</I-SIGNAL-REF>
            </I-SIGNAL-TO-PDU-MAPPING>
          </I-SIGNAL-TO-PDU-MAPPINGS>
        </I-SIGNAL-I-PDU>
        <I-SIGNAL-I-PDU>
          <SHORT-NAME>Chassis_PDU</SHORT-NAME>
          <LENGTH>8</LENGTH>
          <I-SIGNAL-TO-PDU-MAPPINGS>
            <I-SIGNAL-TO-PDU-MAPPING>
              <SHORT-NAME>WheelSpeedFL_Map</SHORT-NAME>
              <START-POSITION>0</START-POSITION>
              <LENGTH>16</LENGTH>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-FIRST</PACKING-BYTE-ORDER>
              <I-SIGNAL-REF DEST="I-SIGNAL">/FlexRayDb/WheelSpeedFL</I-SIGNAL-REF>
            </I-SIGNAL-TO-PDU-MAPPING>
            <I-SIGNAL-TO-PDU-MAPPING>
              <SHORT-NAME>WheelSpeedFR_Map</SHORT-NAME>
              <START-POSITION>16</START-POSITION>
              <LENGTH>16</LENGTH>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-FIRST</PACKING-BYTE-ORDER>
              <I-SIGNAL-REF DEST="I-SIGNAL">/FlexRayDb/WheelSpeedFR</I-SIGNAL-REF>
            </I-SIGNAL-TO-PDU-MAPPING>
            <I-SIGNAL-TO-PDU-MAPPING>
              <SHORT-NAME>YawRate_Map</SHORT-NAME>
              <START-POSITION>32</START-POSITION>
              <LENGTH>16</LENGTH>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-FIRST</PACKING-BYTE-ORDER>
              <I-SIGNAL-REF DEST="I-SIGNAL">/FlexRayDb/YawRate</I-SIGNAL-REF>
            </I-SIGNAL-TO-PDU-MAPPING>
            <I-SIGNAL-TO-PDU-MAPPING>
              <SHORT-NAME>ChassisStatus_Map</SHORT-NAME>
              <START-POSITION>48</START-POSITION>
              <LENGTH>8</LENGTH>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-FIRST</PACKING-BYTE-ORDER>
              <I-SIGNAL-REF DEST="I-SIGNAL">/FlexRayDb/ChassisStatus</I-SIGNAL-REF>
            </I-SIGNAL-TO-PDU-MAPPING>
          </I-SIGNAL-TO-PDU-MAPPINGS>
        </I-SIGNAL-I-PDU>
        <I-SIGNAL-I-PDU>
          <SHORT-NAME>Dash_PDU</SHORT-NAME>
          <LENGTH>4</LENGTH>
          <I-SIGNAL-TO-PDU-MAPPINGS>
            <I-SIGNAL-TO-PDU-MAPPING>
              <SHORT-NAME>Odometer_Map</SHORT-NAME>
              <START-POSITION>0</START-POSITION>
              <LENGTH>24</LENGTH>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-FIRST</PACKING-BYTE-ORDER>
              <I-SIGNAL-REF DEST="I-SIGNAL">/FlexRayDb/Odometer</I-SIGNAL-REF>
            </I-SIGNAL-TO-PDU-MAPPING>
            <I-SIGNAL-TO-PDU-MAPPING>
              <SHORT-NAME>FuelLevel_Map</SHORT-NAME>
              <START-POSITION>24</START-POSITION>
              <LENGTH>8</LENGTH>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-FIRST</PACKING-BYTE-ORDER>
              <I-SIGNAL-REF DEST="I-SIGNAL">/FlexRayDb/FuelLevel</I-SIGNAL-REF>
            </I-SIGNAL-TO-PDU-MAPPING>
          </I-SIGNAL-TO-PDU-MAPPINGS>
        </I-SIGNAL-I-PDU>
        <I-SIGNAL>
          <SHORT-NAME>EngineSpeed</SHORT-NAME>
          <DESC>
            <L-2 L="EN">Engine speed measured at crankshaft</L-2>
          </DESC>
          <LENGTH>16</LENGTH>
        </I-SIGNAL>
        <I-SIGNAL>
          <SHORT-NAME>CoolantTemp</SHORT-NAME>
          <LENGTH>8</LENGTH>
        </I-SIGNAL>
        <I-SIGNAL>
          <SHORT-NAME>ThrottlePos</SHORT-NAME>
          <LENGTH>8</LENGTH>
        </I-SIGNAL>
        <I-SIGNAL>
          <SHORT-NAME>GearEngaged</SHORT-NAME>
          <LENGTH>8</LENGTH>
        </I-SIGNAL>
        <I-SIGNAL>
          <SHORT-NAME>TransTemp</SHORT-NAME>
          <LENGTH>8</LENGTH>
        </I-SIGNAL>
        <I-SIGNAL>
          <SHORT-NAME>TorqueReq</SHORT-NAME>
          <LENGTH>16</LENGTH>
        </I-SIGNAL>
        <I-SIGNAL>
          <SHORT-NAME>WheelSpeedFL</SHORT-NAME>
          <LENGTH>16</LENGTH>
        </I-SIGNAL>
        <I-SIGNAL>
          <SHORT-NAME>WheelSpeedFR</SHORT-NAME>
          <LENGTH>16</LENGTH>
        </I-SIGNAL>
        <I-SIGNAL>
          <SHORT-NAME>YawRate</SHORT-NAME>
          <LENGTH>16</LENGTH>
        </I-SIGNAL>
        <I-SIGNAL>
          <SHORT-NAME>ChassisStatus</SHORT-NAME>
          <LENGTH>8</LENGTH>
        </I-SIGNAL>
        <I-SIGNAL>
          <SHORT-NAME>Odometer</SHORT-NAME>
          <LENGTH>24</LENGTH>
        </I-SIGNAL>
        <I-SIGNAL>
          <SHORT-NAME>FuelLevel</SHORT-NAME>
          <LENGTH>8</LENGTH>
        </I-SIGNAL>
        <FLEXRAY-FRAME>
          <SHORT-NAME>EngineData</SHORT-NAME>
          <DESC>
            <L-2 L="EN">Engine status, transmitted every cycle</L-2>
          </DESC>
          <FRAME-LENGTH>8</FRAME-LENGTH>
          <PAYLOAD-PREAMBLE>false</PAYLOAD-PREAMBLE>
          <FRAME-PDU-MAPPINGS>
            <FRAME-PDU-MAPPING>
              <SHORT-NAME>Eng_PDU_Map</SHORT-NAME>
              <START-POSITION>0</START-POSITION>
              <PDU-REF DEST="I-SIGNAL-I-PDU">/FlexRayDb/Eng_PDU</PDU-REF>
            </FRAME-PDU-MAPPING>
          </FRAME-PDU-MAPPINGS>
        </FLEXRAY-FRAME>
        <FLEXRAY-FRAME>
          <SHORT-NAME>TransmissionData</SHORT-NAME>
          <FRAME-LENGTH>8</FRAME-LENGTH>
          <PAYLOAD-PREAMBLE>false</PAYLOAD-PREAMBLE>
          <FRAME-PDU-MAPPINGS>
            <FRAME-PDU-MAPPING>
              <SHORT-NAME>Trans_PDU_Map</SHORT-NAME>
              <START-POSITION>0</START-POSITION>
              <PDU-REF DEST="I-SIGNAL-I-PDU">/FlexRayDb/Trans_PDU</PDU-REF>
            </FRAME-PDU-MAPPING>
          </FRAME-PDU-MAPPINGS>
        </FLEXRAY-FRAME>
        <FLEXRAY-FRAME>
          <SHORT-NAME>ChassisStatus</SHORT-NAME>
          <FRAME-LENGTH>12</FRAME-LENGTH>
          <PAYLOAD-PREAMBLE>false</PAYLOAD-PREAMBLE>
          <FRAME-PDU-MAPPINGS>
            <FRAME-PDU-MAPPING>
              <SHORT-NAME>Chassis_PDU_Map</SHORT-NAME>
              <START-POSITION>0</START-POSITION>
              <PDU-REF DEST="I-SIGNAL-I-PDU">/FlexRayDb/Chassis_PDU</PDU-REF>
            </FRAME-PDU-MAPPING>
          </FRAME-PDU-MAPPINGS>
        </FLEXRAY-FRAME>
        <FLEXRAY-FRAME>
          <SHORT-NAME>DashInfo</SHORT-NAME>
          <DESC>
            <L-2 L="EN">Multi-PDU frame: reuses Eng_PDU at offset 0</L-2>
          </DESC>
          <FRAME-LENGTH>8</FRAME-LENGTH>
          <PAYLOAD-PREAMBLE>false</PAYLOAD-PREAMBLE>
          <FRAME-PDU-MAPPINGS>
            <FRAME-PDU-MAPPING>
              <SHORT-NAME>Eng_PDU_Map</SHORT-NAME>
              <START-POSITION>0</START-POSITION>
              <PDU-REF DEST="I-SIGNAL-I-PDU">/FlexRayDb/Eng_PDU</PDU-REF>
            </FRAME-PDU-MAPPING>
            <FRAME-PDU-MAPPING>
              <SHORT-NAME>Dash_PDU_Map</SHORT-NAME>
              <START-POSITION>4</START-POSITION>
              <PDU-REF DEST="I-SIGNAL-I-PDU">/FlexRayDb/Dash_PDU</PDU-REF>
            </FRAME-PDU-MAPPING>
          </FRAME-PDU-MAPPINGS>
        </FLEXRAY-FRAME>
      </ELEMENTS>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
